---
import type { GetStaticPaths } from "astro";
import Posts from "@/components/routes/Posts.astro";
import { getPostsIndexPaths } from "@/utils/routePaths";

export const getStaticPaths = (async ({ paginate }) =>
  getPostsIndexPaths(paginate, "zh")) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Posts page={page} />
