---
import { stat } from "node:fs/promises";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getAssetPath } from "@/utils/withBase";
import { resources } from "@/data/resources";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const lang = locale === "en" ? "en" : "zh";

// 读取每个附件的真实文件大小；文件缺失时标记出来
const items = await Promise.all(
  resources.map(async item => {
    let size: number | null = null;
    try {
      size = (await stat(`public/files/${item.file}`)).size;
    } catch {
      size = null;
    }
    return { ...item, size };
  })
);

function formatSize(bytes: number | null): string {
  if (bytes === null) return "";
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<Layout title={`${t.pages.resourcesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={t.pages.resourcesTitle}
    pageDesc={t.pages.resourcesDesc}
  >
    {
      items.length === 0 ? (
        <p class="text-muted-foreground">{t.resources.empty}</p>
      ) : (
        <ul>
          {items.map(item => (
            <li class="border-border my-6 border-b pb-6">
              <h2 class="text-lg font-medium">
                <a
                  href={getAssetPath(`files/${item.file}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {item.name[lang]}
                </a>
              </h2>
              <p class="text-muted-foreground mt-1">
                {item.description[lang]}
              </p>
              <p class="text-muted-foreground mt-2 text-sm">
                {item.date && <span>{item.date}</span>}
                {item.date && item.size !== null && <span> · </span>}
                {item.size !== null && <span>{formatSize(item.size)}</span>}
                {item.size === null && (
                  <span class="text-destructive">{t.resources.missing}</span>
                )}
              </p>
              {item.size !== null && (
                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <LinkButton
                    href={getAssetPath(`files/${item.file}`)}
                    download={item.file}
                  >
                    {t.resources.download}
                    <IconArrowRight class="inline-block rtl:-rotate-180" />
                  </LinkButton>
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
