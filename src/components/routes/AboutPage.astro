---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { DEFAULT_LOCALE } from "@/utils/getPostsByLocale";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const entryId = locale === DEFAULT_LOCALE ? "about" : `${locale}/about`;

const about = await getEntry("pages", entryId);

if (!about) {
  throw new Error(
    `Missing content entry: \`${entryId}.md\` or \`${entryId}.mdx\` in \`src/content/pages/\``
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
